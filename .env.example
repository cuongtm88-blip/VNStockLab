# Copy this file to .env for local development.
# .env must never be committed.

BACKEND_PORT=8000

POSTGRES_USER=vnstocklab
# This sample password is development-only and must never be used in production.
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=vnstocklab
POSTGRES_PORT=5432

REDIS_PORT=6379

VNSTOCKLAB_ENVIRONMENT=development
VNSTOCKLAB_DEBUG=true
VNSTOCKLAB_LOG_LEVEL=INFO
VNSTOCKLAB_ALLOWED_HOSTS=["localhost","127.0.0.1","backend"]
