VNSTOCKLAB_ENVIRONMENT=development
VNSTOCKLAB_DEBUG=true
VNSTOCKLAB_LOG_LEVEL=INFO
VNSTOCKLAB_ALLOWED_HOSTS=["localhost","127.0.0.1"]

# This sample password is development-only and must never be used in production.
VNSTOCKLAB_DATABASE_HOST=localhost
VNSTOCKLAB_DATABASE_PORT=5432
VNSTOCKLAB_DATABASE_NAME=vnstocklab
VNSTOCKLAB_DATABASE_USER=vnstocklab
VNSTOCKLAB_DATABASE_PASSWORD=change-me-local-only
VNSTOCKLAB_DATABASE_ECHO=false
VNSTOCKLAB_DATABASE_POOL_SIZE=5
VNSTOCKLAB_DATABASE_MAX_OVERFLOW=10
VNSTOCKLAB_DATABASE_POOL_TIMEOUT_SECONDS=30
